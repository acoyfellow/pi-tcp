{
	"name": "pi-tcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-19",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"ai": { "binding": "AI" },
	"assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/ws/*"] },
	"alias": { "undici": "./src/workerd/undici.ts" },
	"define": { "import.meta.url": "\"file:///bundle/index.js\"" },
	"connect": [{ "protocol": "tcp", "port": 7000 }],
	"durable_objects": { "bindings": [{ "name": "PI_SESSION", "class_name": "PiSession" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PiSession"] }]
}
