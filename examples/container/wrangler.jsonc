{
	"name": "pi-tcp-container",
	"main": "index.ts",
	"compatibility_date": "2026-11-19",
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
	"connect": [{ "protocol": "tcp", "port": 7000 }],
	"containers": [{ "class_name": "PiBox", "image": "./container/Dockerfile", "max_instances": 1, "instance_type": "standard-1" }],
	"durable_objects": { "bindings": [{ "name": "PI_BOX", "class_name": "PiBox" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["PiBox"] }]
}
